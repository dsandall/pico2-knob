[Unit]
# The pico2joy knob, relaying jogs into the X-Carve through xc-api, on the Pi
# that lives with the machine (shop LAN 192.168.168.5). xc-api is a user unit,
# so there is nothing to order against here: the relay reconnects to it by
# itself, and sits and retries until the puck is plugged in.
Description=pico2joy X-Carve relay
Documentation=https://github.com/softek/pico2-knob
After=network-online.target

[Service]
Type=simple
# dialout for the puck's ttyACM.
User=thebu
Group=thebu
WorkingDirectory=/home/thebu/pico2joy
# xc-api on localhost; it forwards router starts to the puck as `#quiet 1500`.
ExecStart=/usr/bin/python3 /home/thebu/pico2joy/pico2joy.py --link usb xcarve --wait-for-puck --xc http://127.0.0.1:8860
# The fallback while xc is new - the old pendant holding the port:
#ExecStart=/usr/bin/python3 /home/thebu/pico2joy/pico2joy.py --link usb xcarve --wait-for-puck --pendant http://127.0.0.1:8850
Restart=always
RestartSec=5
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
